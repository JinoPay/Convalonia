<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:jino="https://github.com/JinoPay/Jinobald"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             jino:ViewModelLocator.AutoWireViewModel="True">

    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="30" Margin="40">
            <!-- Header -->
            <StackPanel Spacing="10">
                <TextBlock Text="Convalonia"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Multi-Agent Parallel Workspace for Claude"
                           FontSize="16"
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Stats Overview -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
                <!-- Total Workspaces -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding TotalWorkspaces}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="Workspaces"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- Total Agents -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding TotalAgents}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="Active Agents"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- Active Tasks -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ActiveTasks}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="Active Tasks"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Start Guide -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8"
                    Padding="20"
                    BorderBrush="{DynamicResource SystemAccentColor}"
                    BorderThickness="2">
                <StackPanel Spacing="15">
                    <TextBlock Text="🚀 빠른 시작 가이드"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.9">
                        <Run Text="1. 'Workspaces' 탭으로 이동하거나 아래 버튼 클릭"/><LineBreak/>
                        <Run Text="2. 워크스페이스 생성 (빈 상태 또는 GitHub 레포)"/><LineBreak/>
                        <Run Text="3. 워크스페이스 내에서 Claude 에이전트 실행"/><LineBreak/>
                        <Run Text="4. 여러 에이전트를 병렬로 작업시키기"/>
                    </TextBlock>

                    <Button Content="✨ Create New Workspace"
                            Command="{Binding CreateWorkspaceCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="15,10"
                            FontSize="14"
                            FontWeight="SemiBold" />

                    <Button Content="📂 View All Workspaces"
                            Command="{Binding ViewWorkspacesCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="15,10"
                            FontSize="14" />
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="💡 팁"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8">
                        <Run Text="• 워크스페이스 생성 시 Git URL 비우면 현재 디렉토리를 자동 감지"/><LineBreak/>
                        <Run Text="• 각 워크스페이스는 독립적인 환경과 Git 상태 유지"/><LineBreak/>
                        <Run Text="• 여러 에이전트를 동시에 실행하여 병렬 작업 가능"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Features Overview -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    Padding="20"
                    CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="Key Features"
                               FontWeight="SemiBold"
                               FontSize="18" />
                    <TextBlock Text="✓ Multiple workspaces with independent environments" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Parallel Claude agent execution" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Real-time terminal output monitoring" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Integrated GitHub operations (clone, branch, commit, push)" TextWrapping="Wrap" />
                    <TextBlock Text="✓ File system management" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Claude Code CLI integration" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
