<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:jino="https://github.com/JinoPay/Jinobald"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             jino:ViewModelLocator.AutoWireViewModel="True">

    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="30" Margin="40">
            <!-- Header -->
            <StackPanel Spacing="10">
                <TextBlock Text="Convalonia"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Multi-Agent Parallel Workspace for Claude"
                           FontSize="16"
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Stats Overview -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
                <!-- Total Workspaces -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding TotalWorkspaces}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="Workspaces"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- Total Agents -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding TotalAgents}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="Active Agents"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>

                <!-- Active Tasks -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ActiveTasks}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="Active Tasks"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="Quick Actions"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <Button Content="Create New Workspace"
                            Command="{Binding CreateWorkspaceCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="15,10" />

                    <Button Content="View All Workspaces"
                            Command="{Binding ViewWorkspacesCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="15,10" />
                </StackPanel>
            </Border>

            <!-- Features Overview -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    Padding="20"
                    CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="Key Features"
                               FontWeight="SemiBold"
                               FontSize="18" />
                    <TextBlock Text="✓ Multiple workspaces with independent environments" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Parallel Claude agent execution" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Real-time terminal output monitoring" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Integrated GitHub operations (clone, branch, commit, push)" TextWrapping="Wrap" />
                    <TextBlock Text="✓ File system management" TextWrapping="Wrap" />
                    <TextBlock Text="✓ Claude Code CLI integration" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
