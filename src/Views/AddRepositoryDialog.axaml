<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Convalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="Convalonia.Views.AddRepositoryDialog"
        x:DataType="vm:AddRepositoryViewModel"
        Title="Add Repository"
        Width="600"
        Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Add Repository to Workspace"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- Method Selection -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Select Method:" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <RadioButton Content="Open Project"
                                     IsChecked="{Binding SelectedMethod, Converter={StaticResource EqualityConverter}, ConverterParameter=OpenProject}"
                                     Command="{Binding SelectMethodCommand}"
                                     CommandParameter="OpenProject"/>
                        <RadioButton Content="Clone From URL"
                                     IsChecked="{Binding SelectedMethod, Converter={StaticResource EqualityConverter}, ConverterParameter=CloneFromUrl}"
                                     Command="{Binding SelectMethodCommand}"
                                     CommandParameter="CloneFromUrl"/>
                        <RadioButton Content="Quick Start"
                                     IsChecked="{Binding SelectedMethod, Converter={StaticResource EqualityConverter}, ConverterParameter=QuickStart}"
                                     Command="{Binding SelectMethodCommand}"
                                     CommandParameter="QuickStart"/>
                    </StackPanel>
                </StackPanel>

                <!-- Open Project Section -->
                <Border IsVisible="{Binding SelectedMethod, Converter={StaticResource EqualityConverter}, ConverterParameter=OpenProject}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        Padding="15"
                        CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Open Local Git Project" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Select a local git repository to add to your workspace."
                                   TextWrapping="Wrap"
                                   Opacity="0.7"/>

                        <TextBlock Text="Project Path:" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding LocalProjectPath}"
                                     Watermark="/path/to/your/git/repository"/>
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Command="{Binding BrowseProjectCommand}"
                                    Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Clone From URL Section -->
                <Border IsVisible="{Binding SelectedMethod, Converter={StaticResource EqualityConverter}, ConverterParameter=CloneFromUrl}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        Padding="15"
                        CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Clone Repository from URL" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Clone a git repository from a remote URL."
                                   TextWrapping="Wrap"
                                   Opacity="0.7"/>

                        <TextBlock Text="Repository URL:" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding GitUrl}"
                                 Watermark="https://github.com/user/repo.git"/>

                        <TextBlock Text="Branch (optional):" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding BranchName}"
                                 Watermark="main"/>

                        <CheckBox Content="Search archived branches"
                                  IsChecked="{Binding SearchArchivedBranches}"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Quick Start Section -->
                <Border IsVisible="{Binding SelectedMethod, Converter={StaticResource EqualityConverter}, ConverterParameter=QuickStart}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        Padding="15"
                        CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Quick Start" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Create a new empty git repository to get started quickly."
                                   TextWrapping="Wrap"
                                   Opacity="0.7"/>
                        <TextBlock Text="A new git repository will be initialized in your workspace."
                                   TextWrapping="Wrap"
                                   Opacity="0.6"
                                   FontSize="12"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Additional Options -->
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                        Padding="15"
                        CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Additional Options" FontWeight="SemiBold"/>
                        <CheckBox Content="Search archived branches"
                                  IsChecked="{Binding SearchArchivedBranches}"
                                  ToolTip.Tip="Include archived branches when searching for branches in this repository"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,20,0,0">
            <Button Grid.Column="1"
                    Content="Add Repository"
                    Command="{Binding AddRepositoryCommand}"
                    IsEnabled="{Binding !IsProcessing}"
                    Padding="20,8"/>
            <Button Grid.Column="2"
                    Content="Cancel"
                    Click="OnCancelClick"
                    IsEnabled="{Binding !IsProcessing}"
                    Margin="10,0,0,0"
                    Padding="20,8"/>
        </Grid>
    </Grid>
</Window>
