<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:models="using:Convalonia.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

  <Grid ColumnDefinitions="250,*">
    <!-- Agent List Sidebar -->
    <Border Grid.Column="0"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="0,0,1,0"
            Padding="15">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Workspace Info -->
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
          <TextBlock Text="{Binding WorkspaceName}" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="{Binding CurrentBranch, StringFormat='Branch: {0}'}"
                     FontSize="12"
                     Opacity="0.7"
                     IsVisible="{Binding CurrentBranch, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <!-- Create Agent Button -->
        <Button Grid.Row="1"
                Content="+ New Agent"
                Command="{Binding CreateAgentCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,15"/>

        <!-- Agents List -->
        <ScrollViewer Grid.Row="2">
          <ItemsControl ItemsSource="{Binding Agents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="×"
                            FontSize="16"
                            Width="24"
                            Height="24"
                            Command="{Binding $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).DeleteAgentCommand}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Workspace Actions -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,15,0,0">
          <Button Content="Open Folder"
                  Command="{Binding OpenWorkspaceFolderCommand}"
                  HorizontalAlignment="Stretch"/>
          <Button Content="Stop All Agents"
                  Command="{Binding StopAllAgentsCommand}"
                  HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Agent Chat Area -->
    <Border Grid.Column="1">
      <Grid>
        <TextBlock Text="Select an agent to start chatting"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Opacity="0.5"
                   IsVisible="{Binding !SelectedAgentChatViewModel}"/>

        <ContentControl Content="{Binding SelectedAgentChatViewModel}"
                        IsVisible="{Binding SelectedAgentChatViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:ChatViewModel">
              <!-- Embed ChatView here -->
              <Grid RowDefinitions="Auto,*,Auto">
                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="15">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding AgentName}" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <Button Content="Toggle Terminal" Command="{Binding ToggleTerminalCommand}"/>
                      <Button Content="Stop Session" Command="{Binding StopSessionCommand}"/>
                      <Button Content="Clear Chat" Command="{Binding ClearChatCommand}"/>
                      <Button Content="Cancel"
                              Command="{Binding CancelSendingCommand}"
                              IsVisible="{Binding IsSending}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Content Area: Split between Messages and Terminal -->
                <Grid Grid.Row="1" ColumnDefinitions="*,5,*">
                  <!-- Messages Panel -->
                  <ScrollViewer Grid.Column="0" Padding="15">
                    <ItemsControl ItemsSource="{Binding Messages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="12"
                                  Margin="0,0,0,10"
                                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                            <Grid RowDefinitions="Auto,Auto">
                              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Role}"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                           FontSize="11"
                                           Opacity="0.6"/>
                              </StackPanel>

                              <TextBlock Grid.Row="1"
                                         Text="{Binding Content}"
                                         TextWrapping="Wrap"
                                         FontSize="14"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <!-- Splitter -->
                  <GridSplitter Grid.Column="1"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                IsVisible="{Binding ShowTerminal}"/>

                  <!-- Terminal Output Panel -->
                  <Border Grid.Column="2"
                          BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                          BorderThickness="1,0,0,0"
                          Background="#1E1E1E"
                          IsVisible="{Binding ShowTerminal}">
                    <Grid RowDefinitions="Auto,*">
                      <Border Grid.Row="0"
                              Background="#2D2D2D"
                              Padding="10">
                        <TextBlock Text="Terminal Output"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"/>
                      </Border>

                      <ScrollViewer Grid.Row="1" Padding="10">
                        <TextBlock Text="{Binding TerminalOutput}"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="12"
                                   Foreground="#00FF00"
                                   TextWrapping="Wrap"/>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                </Grid>

                <!-- Input Area -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="15">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding InputMessage}"
                             Watermark="Type your message here..."
                             AcceptsReturn="True"
                             MinHeight="60"
                             MaxHeight="200"
                             TextWrapping="Wrap"
                             IsEnabled="{Binding !IsSending}"/>

                    <Button Grid.Column="1"
                            Content="Send"
                            Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding !IsSending}"
                            VerticalAlignment="Bottom"
                            Margin="10,0,0,0"
                            Width="80"
                            Height="40"/>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
