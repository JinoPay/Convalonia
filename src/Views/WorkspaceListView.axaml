<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.WorkspaceListView"
             x:DataType="vm:WorkspaceListViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="20">
      <TextBlock Text="Workspaces" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

      <!-- Create Workspace Form -->
      <Border BorderBrush="{DynamicResource SystemAccentColor}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="15"
              Margin="0,0,0,20">
        <StackPanel Spacing="10">
          <TextBlock Text="Create New Workspace" FontSize="16" FontWeight="SemiBold"/>

          <TextBox Text="{Binding NewWorkspaceName}"
                   Watermark="Workspace name (leave empty for random name)"
                   Width="400"
                   HorizontalAlignment="Left"/>

          <TextBlock Text="Git repository URL (optional):" FontSize="12" Opacity="0.8" Margin="0,5,0,0"/>
          <TextBlock Text="Leave empty to use current directory if it's a git repo"
                     FontSize="11"
                     Opacity="0.6"
                     Margin="0,0,0,5"/>

          <TextBox Text="{Binding GitRepositoryUrl}"
                   Watermark="e.g., https://github.com/user/repo.git"
                   Width="400"
                   HorizontalAlignment="Left"/>

          <Button Content="Create Workspace"
                  Command="{Binding CreateWorkspaceCommand}"
                  IsEnabled="{Binding !IsCreatingWorkspace}"
                  HorizontalAlignment="Left"
                  Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Workspace List -->
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Workspaces}" Margin="20,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,10"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.7"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Status}" FontSize="12"/>
                    <TextBlock Text="•" FontSize="12"/>
                    <TextBlock Text="{Binding Agents.Count, StringFormat='{}{0} agents'}" FontSize="12"/>
                    <TextBlock Text="•" FontSize="12" IsVisible="{Binding GitBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding GitBranch, StringFormat='Branch: {0}'}"
                               FontSize="12"
                               IsVisible="{Binding GitBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding LastAccessedAt, StringFormat='Last accessed: {0:g}'}"
                             FontSize="11"
                             Opacity="0.6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Content="Open"
                          Command="{Binding $parent[ItemsControl].((vm:WorkspaceListViewModel)DataContext).SelectWorkspaceCommand}"
                          CommandParameter="{Binding}"/>
                  <Button Content="Delete"
                          Command="{Binding $parent[ItemsControl].((vm:WorkspaceListViewModel)DataContext).DeleteWorkspaceCommand}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
