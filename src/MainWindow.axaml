<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:jino="https://github.com/JinoPay/Jinobald"
        xmlns:views="using:Convalonia.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Convalonia.MainWindow"
        Title="Convalonia - Multi-Agent Workspace"
        Width="800" Height="600"
        jino:ViewModelLocator.AutoWireViewModel="True">

    <jino:DialogHost x:Name="DialogHost">
        <Panel>
            <!-- Main Content Region -->
            <ContentControl jino:Region.Name="MainContentRegion"
                          jino:Region.DefaultView="views:SetupView"
                          jino:Region.KeepAlive="True" />

            <!-- Toast Notification Host -->
            <jino:ToastHost x:Name="ToastHost" Position="TopRight" />
        </Panel>
    </jino:DialogHost>
</Window>
