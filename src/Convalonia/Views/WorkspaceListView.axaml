<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.WorkspaceListView"
             x:DataType="vm:WorkspaceListViewModel">

  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="20">
      <TextBlock Text="Workspaces" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

      <!-- Create Workspace Form -->
      <Border BorderBrush="{DynamicResource SystemAccentColor}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="15"
              Margin="0,0,0,20">
        <StackPanel Spacing="10">
          <TextBlock Text="Create New Workspace" FontSize="16" FontWeight="SemiBold"/>

          <!-- Instructions -->
          <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  CornerRadius="4"
                  Padding="10"
                  Margin="0,5,0,10">
            <StackPanel Spacing="5">
              <TextBlock Text="💡 사용 방법:" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="1️⃣ 빈 워크스페이스: 모든 필드를 비워두고 'Create' 클릭"
                         FontSize="12" TextWrapping="Wrap"/>
              <TextBlock Text="2️⃣ GitHub에서 클론: Git URL 입력 후 'Create' 클릭 (예: https://github.com/user/repo.git)"
                         FontSize="12" TextWrapping="Wrap"/>
              <TextBlock Text="3️⃣ 로컬 git 레포: Git URL을 비워두면 현재 디렉토리를 자동 감지"
                         FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <TextBlock Text="워크스페이스 이름 (선택사항):" FontSize="12" FontWeight="SemiBold"/>
          <TextBox Text="{Binding NewWorkspaceName}"
                   Watermark="비워두면 랜덤 이름이 자동 생성됩니다 (예: purple-mountain)"
                   Width="500"
                   HorizontalAlignment="Left"/>

          <TextBlock Text="Git 레포지토리 URL (선택사항):" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/>
          <TextBox Text="{Binding GitRepositoryUrl}"
                   Watermark="예: https://github.com/anthropics/claude-code.git (비워두면 현재 디렉토리 사용)"
                   Width="500"
                   HorizontalAlignment="Left"/>

          <Button Content="✨ Create Workspace"
                  Command="{Binding CreateWorkspaceCommand}"
                  IsEnabled="{Binding !IsCreatingWorkspace}"
                  HorizontalAlignment="Left"
                  Margin="0,15,0,0"
                  Padding="20,8"
                  FontSize="14"
                  FontWeight="SemiBold"/>

          <TextBlock Text="{Binding IsCreatingWorkspace, Converter={x:Static StringConverters.IsNotNullOrEmpty}, ConverterParameter='⏳ 워크스페이스 생성 중...'}"
                     FontSize="12"
                     Opacity="0.7"
                     IsVisible="{Binding IsCreatingWorkspace}"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Workspace List -->
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Workspaces}" Margin="20,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,10"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.7"/>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Status}" FontSize="12"/>
                    <TextBlock Text="•" FontSize="12"/>
                    <TextBlock Text="{Binding Agents.Count, StringFormat='{}{0} agents'}" FontSize="12"/>
                    <TextBlock Text="•" FontSize="12" IsVisible="{Binding GitBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding GitBranch, StringFormat='Branch: {0}'}"
                               FontSize="12"
                               IsVisible="{Binding GitBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding LastAccessedAt, StringFormat='Last accessed: {0:g}'}"
                             FontSize="11"
                             Opacity="0.6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Content="Open"
                          Command="{Binding $parent[ItemsControl].((vm:WorkspaceListViewModel)DataContext).SelectWorkspaceCommand}"
                          CommandParameter="{Binding}"/>
                  <Button Content="Delete"
                          Command="{Binding $parent[ItemsControl].((vm:WorkspaceListViewModel)DataContext).DeleteWorkspaceCommand}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
