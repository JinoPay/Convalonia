<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:models="using:Convalonia.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.RepositoryDetailView"
             x:DataType="vm:RepositoryDetailViewModel">

    <Design.DataContext>
        <vm:RepositoryDetailViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header with Back Button -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20"
                BorderBrush="{DynamicResource SystemAccentColor}"
                BorderThickness="0,0,0,2">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Content="← 뒤로"
                        Command="{Binding BackToRepositoryListCommand}"
                        Padding="12,6"
                        FontSize="13"
                        Margin="0,0,15,0" />

                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{Binding Repository.Name}"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding Repository.SourcePath}"
                               FontSize="12"
                               Opacity="0.7" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="14" VerticalAlignment="Center" Opacity="0.7">
                        <Run Text="🗂️" />
                        <Run Text="{Binding Workspaces.Count}" />
                        <Run Text="워크스페이스" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Create Workspace Section -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                Padding="20"
                BorderBrush="{DynamicResource SystemAccentColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding NewWorkspaceName}"
                         Watermark="워크스페이스 이름 (비워두면 자동 생성)"
                         Padding="10"
                         FontSize="14" />

                <Button Grid.Column="1"
                        Content="+ 워크스페이스 생성"
                        Command="{Binding CreateWorkspaceCommand}"
                        IsEnabled="{Binding !IsCreatingWorkspace}"
                        Padding="15,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- Workspace List -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="0" Margin="20">
                <!-- Empty State -->
                <Border IsVisible="{Binding !Workspaces.Count}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="8"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="15" HorizontalAlignment="Center">
                        <TextBlock Text="📋"
                                   FontSize="48"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="워크스페이스가 없습니다"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="새 워크스페이스를 생성하여 시작하세요"
                                   FontSize="14"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Workspace Items -->
                <ItemsControl ItemsSource="{Binding Workspaces}"
                              IsVisible="{Binding Workspaces.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:Workspace">
                            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,0,15"
                                    BorderBrush="{DynamicResource SystemAccentColor}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <!-- Workspace Info -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock FontSize="12" Opacity="0.7">
                                                <Run Text="🌿" />
                                                <Run Text="{Binding GitBranch}" />
                                            </TextBlock>
                                            <TextBlock Text="|" FontSize="12" Opacity="0.5" />
                                            <TextBlock FontSize="12" Opacity="0.7">
                                                <Run Text="👥" />
                                                <Run Text="{Binding Agents.Count}" />
                                                <Run Text="에이전트" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <Button Content="열기"
                                                Command="{Binding $parent[UserControl].((vm:RepositoryDetailViewModel)DataContext).SelectWorkspaceCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="15,8"
                                                FontSize="13" />

                                        <Button Content="🗑️"
                                                Command="{Binding $parent[UserControl].((vm:RepositoryDetailViewModel)DataContext).DeleteWorkspaceCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,6"
                                                FontSize="13"
                                                ToolTip.Tip="워크스페이스 삭제" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
