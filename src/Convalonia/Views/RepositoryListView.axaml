<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:models="using:Convalonia.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.RepositoryListView"
             x:DataType="vm:RepositoryListViewModel">

    <Design.DataContext>
        <vm:RepositoryListViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20"
                BorderBrush="{DynamicResource SystemAccentColor}"
                BorderThickness="0,0,0,2">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="레포지토리"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Git 레포지토리와 워크스페이스 관리"
                               FontSize="13"
                               Opacity="0.7" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ 레포지토리 추가"
                        Command="{Binding AddRepositoryCommand}"
                        Padding="15,8"
                        FontSize="14"
                        FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Repository List -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="0" Margin="20">
                <!-- Empty State -->
                <Border IsVisible="{Binding !Repositories.Count}"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="8"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="15" HorizontalAlignment="Center">
                        <TextBlock Text="📂"
                                   FontSize="48"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="등록된 레포지토리가 없습니다"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="새 레포지토리를 추가하여 시작하세요"
                                   FontSize="14"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                        <Button Content="레포지토리 추가"
                                Command="{Binding AddRepositoryCommand}"
                                HorizontalAlignment="Center"
                                Padding="20,10"
                                FontSize="14"
                                Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Repository Items -->
                <ItemsControl ItemsSource="{Binding Repositories}"
                              IsVisible="{Binding Repositories.Count}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:SourceRepository">
                            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,0,15"
                                    BorderBrush="{DynamicResource SystemAccentColor}"
                                    BorderThickness="1">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <!-- Repository Name and Info -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock FontSize="12" Opacity="0.7">
                                                <Run Text="📍" />
                                                <Run Text="{Binding SourceType}" />
                                            </TextBlock>
                                            <TextBlock Text="|" FontSize="12" Opacity="0.5" />
                                            <TextBlock FontSize="12" Opacity="0.7">
                                                <Run Text="🗂️" />
                                                <Run Text="{Binding Workspaces.Count}" />
                                                <Run Text="워크스페이스" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SourcePath}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center">
                                        <Button Content="워크스페이스 보기"
                                                Command="{Binding $parent[UserControl].((vm:RepositoryListViewModel)DataContext).SelectRepositoryCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                FontSize="13" />

                                        <Button Content="+ 새 워크스페이스"
                                                Command="{Binding $parent[UserControl].((vm:RepositoryListViewModel)DataContext).CreateWorkspaceCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="12,6"
                                                FontSize="13" />

                                        <Button Content="🗑️"
                                                Command="{Binding $parent[UserControl].((vm:RepositoryListViewModel)DataContext).RemoveRepositoryCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="8,6"
                                                FontSize="13"
                                                ToolTip.Tip="레포지토리 제거" />
                                    </StackPanel>

                                    <!-- Workspaces Preview (if any) -->
                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            IsVisible="{Binding Workspaces.Count}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="6"
                                            Padding="15"
                                            Margin="0,10,0,0">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="최근 워크스페이스"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.8" />

                                            <ItemsControl ItemsSource="{Binding Workspaces}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="models:Workspace">
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4,2"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Command="{Binding $parent[UserControl].((vm:RepositoryListViewModel)DataContext).OpenWorkspaceCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="클릭하여 워크스페이스 열기">
                                                            <TextBlock FontSize="11" Opacity="0.7">
                                                                <Run Text="•" />
                                                                <Run Text="{Binding Name}" />
                                                                <Run Text="(" />
                                                                <Run Text="{Binding GitBranch}" />
                                                                <Run Text=")" />
                                                            </TextBlock>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
