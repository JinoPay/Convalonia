<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Convalonia.Controls"
        xmlns:nav="using:Convalonia.Services.Navigation"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Convalonia.MainWindow"
        Title="Convalonia - Multi-Agent Workspace"
        Width="800" Height="600">

    <controls:DialogHost x:Name="DialogHost">
        <Panel>
            <!-- Main Content Region -->
            <ContentControl nav:Region.Name="MainContentRegion"
                          nav:Region.KeepAlive="True" />

            <!-- Toast Notification Host -->
            <controls:ToastHost x:Name="ToastHost" Position="TopRight" />
        </Panel>
    </controls:DialogHost>
</Window>
