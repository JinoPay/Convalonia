<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Convalonia.Controls">
    <Design.PreviewWith>
        <Border Padding="20">
            <controls:DialogHost>
                <TextBlock Text="Content" />
            </controls:DialogHost>
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|DialogHost">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Main content -->
                    <ContentPresenter Content="{TemplateBinding Content}" />

                    <!-- Dialog overlay -->
                    <Panel IsVisible="{TemplateBinding IsDialogOpen}"
                           Background="#80000000">
                        <Border Background="{DynamicResource SystemChromeMediumColor}"
                                CornerRadius="8"
                                Padding="20"
                                MaxWidth="600"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding DialogContent}" />
                        </Border>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
