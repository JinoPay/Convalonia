<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:jino="https://github.com/JinoPay/Jinobald"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             jino:ViewModelLocator.AutoWireViewModel="True">

    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>

    <StackPanel Spacing="20" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Title -->
        <TextBlock Text="{Binding Title}"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <!-- Welcome Message -->
        <TextBlock Text="{Binding WelcomeMessage}"
                   FontSize="18"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="600" />

        <!-- Divider -->
        <Separator Margin="0,20" />

        <!-- Counter Display -->
        <Border BorderBrush="{DynamicResource SystemAccentColor}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="30">
            <StackPanel Spacing="10">
                <TextBlock Text="Counter Demo"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="{Binding Counter}"
                           FontSize="48"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemAccentColor}" />
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Spacing="10" Orientation="Vertical">
            <Button Content="Increment Counter"
                    Command="{Binding IncrementCounterCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,10" />

            <Button Content="Show Info"
                    Command="{Binding ShowInfoCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,10" />

            <Button Content="Reset Counter"
                    Command="{Binding ResetCounterCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="20,10" />
        </StackPanel>

        <!-- Framework Info -->
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20"
                CornerRadius="8"
                Margin="0,20,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="Framework Features:"
                           FontWeight="SemiBold"
                           FontSize="16" />
                <TextBlock Text="✓ View-First Navigation with Region Manager" TextWrapping="Wrap" />
                <TextBlock Text="✓ Dialog Service with Strong Typing" TextWrapping="Wrap" />
                <TextBlock Text="✓ Toast Notifications" TextWrapping="Wrap" />
                <TextBlock Text="✓ Event Aggregation" TextWrapping="Wrap" />
                <TextBlock Text="✓ Dependency Injection" TextWrapping="Wrap" />
                <TextBlock Text="✓ MVVM Pattern with CommunityToolkit" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
