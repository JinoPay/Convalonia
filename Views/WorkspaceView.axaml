<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Convalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Convalonia.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

  <Grid ColumnDefinitions="250,*">
    <!-- Agent List Sidebar -->
    <Border Grid.Column="0"
            BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="0,0,1,0"
            Padding="15">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Workspace Info -->
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
          <TextBlock Text="{Binding WorkspaceName}" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="{Binding CurrentBranch, StringFormat='Branch: {0}'}"
                     FontSize="12"
                     Opacity="0.7"
                     IsVisible="{Binding CurrentBranch, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <!-- Create Agent Button -->
        <Button Grid.Row="1"
                Content="+ New Agent"
                Command="{Binding CreateAgentCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,15"/>

        <!-- Agents List -->
        <ScrollViewer Grid.Row="2">
          <ItemsControl ItemsSource="{Binding Agents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,8"
                        Background="{Binding IsSelected, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="×"
                            FontSize="16"
                            Width="24"
                            Height="24"
                            Command="{Binding $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).DeleteAgentCommand}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Workspace Actions -->
        <StackPanel Grid.Row="3" Spacing="8" Margin="0,15,0,0">
          <Button Content="Open Folder"
                  Command="{Binding OpenWorkspaceFolderCommand}"
                  HorizontalAlignment="Stretch"/>
          <Button Content="Stop All Agents"
                  Command="{Binding StopAllAgentsCommand}"
                  HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Agent Chat Area -->
    <Border Grid.Column="1" Padding="20">
      <ContentControl Content="{Binding SelectedAgent}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <!-- Chat interface will be shown here -->
            <TextBlock Text="Select an agent to start chatting"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Opacity="0.5"
                       IsVisible="{Binding !SelectedAgent}"/>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>
  </Grid>
</UserControl>
